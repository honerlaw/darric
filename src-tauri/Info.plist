<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>Required to record your microphones during a recording.</string>
  <!-- Core Audio process taps are gated on the audio-recording permission, not
       on screen recording. The app previously declared NSScreenCaptureUsageDescription
       for a ScreenCaptureKit path that was never implemented; taps replace it,
       and the audio-only prompt is markedly less alarming to grant. -->
  <key>NSAudioCaptureUsageDescription</key>
  <string>Required to record audio your Mac is playing, such as the other side of a call.</string>
</dict>
</plist>
